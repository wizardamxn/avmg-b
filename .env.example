# ============================================================
#  AVMG BACKEND (avmg-b) — environment variables
#  Fill in the values below. This file is gitignored (never committed).
# ============================================================

# --- Database (PostgreSQL, used by Prisma) -------------------
# Get this from your Postgres / Supabase project (Connection string).
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL="HERES-YOUR-DATABASE-URL"

# --- File downloads ---------------------------------------------
# Finished files are kept on this server's disk (uploads/out) and served by
# GET /api/files/:name. This is the public URL of THIS API that browsers use to
# reach those links (no trailing slash). Defaults to http://localhost:<PORT>.
PUBLIC_API_URL="http://localhost:5000"

# --- Redis (the job queue / BullMQ) --------------------------
# Local example: redis://localhost:6379
# Hosted example (Upstash/Railway): redis://default:password@host:port
REDIS_URL="redis://localhost:2222"

# --- Server ---------------------------------------------------
# Port the API listens on (defaults to 5000 if omitted)
PORT=5000
# "development" or "production"
NODE_ENV=development

# --- Auth (JWT) ----------------------------------------------
# Long random secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-hex-string"


# --- CORS -----------------------------------------------------
# The deployed frontend origin allowed to call this API. localhost:3000 is
# always allowed for local dev, so this can be left blank locally.
FRONTEND_ORIGIN=""

# --- Size limits (optional; defaults shown) ------------------
# Max upload per file for guests / signed-in users, and the probed size cap
# on links guests download. Raise them locally for testing big files.
GUEST_MAX_UPLOAD_MB=5
FREE_MAX_UPLOAD_MB=100
GUEST_MAX_REMOTE_MB=50

# CPU threads each ffmpeg job may use (default 2). Lower = gentler on the machine, slower jobs.
FFMPEG_THREADS=2

# --- Cleanup cron (optional, sensible defaults exist) --------
# How long a finished file stays downloadable before being deleted (hours)
FILE_RETENTION_HOURS=1
# When the cleanup sweep runs (cron syntax). Default: top of every hour.
CLEANUP_CRON="0 * * * *"
