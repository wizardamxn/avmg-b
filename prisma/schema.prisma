// prisma/schema.prisma

generator client {
  provider   = "prisma-client-js"
  engineType = "client" // Rust-free: no native query engine (see src/lib/prisma.js)
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  name         String?
  passwordHash String // bcrypt hash — never returned to clients

  // false = signed up but hasn't entered the emailed code yet (existing users default to true)
  emailVerified Boolean   @default(true)
  otpHash       String? // HMAC of the 6-digit code, never the code itself
  otpExpires    DateTime?
  otpAttempts   Int       @default(0)
  otpSentAt     DateTime?

  createdAt DateTime   @default(now())
  mediaJobs MediaJob[]
}

model MediaJob {
  id     String  @id @default(uuid())
  userId String? // set for registered users; null for guests
  ip     String? // requester IP — powers guest daily quotas

  // ⚙️ Engine tracker: job-convert | job-download | job-download-convert | job-ai-notes
  jobType String @default("unknown")

  // 📦 Inputs
  originalName String? // local upload filename
  url          String? // network URL

  // 🎛️ Parameters
  targetFormat String? // mp3, mp4, txt, md, ...
  quality      String? // best, good, draft

  // 📤 Outputs
  fileName       String?
  path           String? // Supabase public URL (null once swept / for notes jobs)
  size           Int? // bytes of the produced file
  transcriptPath String?
  notesMarkdown  String? @db.Text // AI study notes (markdown, stored in DB)
  error          String? // human-readable failure reason

  // 🚥 State
  status    JobStatus @default(PENDING)
  expiresAt DateTime? // per-tier file expiry; cleanup sweeps past this

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@index([status, expiresAt])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
